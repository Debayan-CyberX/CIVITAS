{
  "name": "civitas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "npm run dev --workspace @civitas/web",
    "preview": "npm run preview --workspace @civitas/web",
    "build": "npm run build --workspace @civitas/web",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test:unit && npm run test:properties",
    "test:unit": "vitest run --project unit",
    "test:properties": "vitest run --project properties",
    "test:e2e": "playwright test --grep-invert accessibility",
    "test:a11y": "playwright test --grep accessibility",
    "audit:registry": "node scripts/audit-registry.mjs",
    "audit:dependencies": "npm ls --all",
    "verify:b01": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e && npm run test:a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
